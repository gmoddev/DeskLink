diff --git a/src/platform/tls_cng_provider.c b/src/platform/tls_cng_provider.c
new file mode 100644
index 0000000..41f47b7
--- /dev/null
+++ b/src/platform/tls_cng_provider.c
@@ -0,0 +1,897 @@
+/*++
+
+    Copyright (c) Microsoft Corporation.
+    Licensed under the MIT License.
+
+Abstract:
+
+    Implements the minimal built-in OpenSSL 3 provider used by DeskLink to
+    sign TLS 1.3 CertificateVerify messages with an existing opaque CNG key.
+    The provider never exports private key material.
+
+--*/
+
+#include "platform_internal.h"
+#include "tls_cng_provider.h"
+
+#ifdef _WIN32
+
+#include <ncrypt.h>
+#include <wincrypt.h>
+
+#include <openssl/core_dispatch.h>
+#include <openssl/core_names.h>
+#include <openssl/param_build.h>
+#include <openssl/params.h>
+#include <openssl/rsa.h>
+
+#define CXPLAT_CNG_PROVIDER_NAME "desklink-cng"
+#define CXPLAT_CNG_KSP_PARAM "desklink-cng-ksp"
+#define CXPLAT_CNG_KEY_NAME_PARAM "desklink-cng-key-name"
+#define CXPLAT_CNG_MAX_NAME 256
+
+typedef struct CXPLAT_CNG_KEY {
+    NCRYPT_PROV_HANDLE ProviderHandle;
+    NCRYPT_KEY_HANDLE Handle;
+    WCHAR ProviderName[CXPLAT_CNG_MAX_NAME];
+    WCHAR KeyName[CXPLAT_CNG_MAX_NAME];
+    BIGNUM* Modulus;
+    BIGNUM* Exponent;
+    uint32_t Bits;
+} CXPLAT_CNG_KEY;
+
+typedef struct CXPLAT_CNG_SIGNATURE_CONTEXT {
+    CXPLAT_CNG_KEY* Key;
+    LPCWSTR HashAlgorithm;
+    uint32_t HashLength;
+    uint32_t SaltLength;
+    BOOLEAN PssPadding;
+} CXPLAT_CNG_SIGNATURE_CONTEXT;
+
+static
+BOOLEAN
+CxPlatCngReadDwordProperty(
+    _In_ NCRYPT_KEY_HANDLE Key,
+    _In_z_ LPCWSTR Property,
+    _Out_ DWORD* Value
+    );
+
+static
+BOOLEAN
+CxPlatCngOpenNamedKey(
+    _In_z_ LPCWSTR ProviderName,
+    _In_z_ LPCWSTR KeyName,
+    _Out_ NCRYPT_PROV_HANDLE* ProviderHandle,
+    _Out_ NCRYPT_KEY_HANDLE* KeyHandle
+    )
+{
+    DWORD ExportPolicy = 0;
+    DWORD KeyUsage = 0;
+    WCHAR Algorithm[64] = {0};
+    DWORD AlgorithmLength = 0;
+    *ProviderHandle = 0;
+    *KeyHandle = 0;
+    if (NCryptOpenStorageProvider(ProviderHandle, ProviderName, 0) != ERROR_SUCCESS ||
+        NCryptOpenKey(*ProviderHandle, KeyHandle, KeyName, 0, NCRYPT_SILENT_FLAG) != ERROR_SUCCESS ||
+        !CxPlatCngReadDwordProperty(*KeyHandle, NCRYPT_EXPORT_POLICY_PROPERTY, &ExportPolicy) ||
+        ExportPolicy != 0 ||
+        !CxPlatCngReadDwordProperty(*KeyHandle, NCRYPT_KEY_USAGE_PROPERTY, &KeyUsage) ||
+        (KeyUsage & NCRYPT_ALLOW_SIGNING_FLAG) == 0 ||
+        NCryptGetProperty(*KeyHandle, NCRYPT_ALGORITHM_PROPERTY, (PBYTE)Algorithm,
+                          sizeof(Algorithm), &AlgorithmLength, 0) != ERROR_SUCCESS ||
+        AlgorithmLength < sizeof(WCHAR) || _wcsicmp(Algorithm, NCRYPT_RSA_ALGORITHM) != 0) {
+        if (*KeyHandle != 0) NCryptFreeObject(*KeyHandle);
+        if (*ProviderHandle != 0) NCryptFreeObject(*ProviderHandle);
+        *ProviderHandle = 0;
+        *KeyHandle = 0;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static
+void*
+CxPlatCngKeyNew(
+    _In_opt_ void* ProviderContext
+    )
+{
+    UNREFERENCED_PARAMETER(ProviderContext);
+    return OPENSSL_zalloc(sizeof(CXPLAT_CNG_KEY));
+}
+
+static
+void
+CxPlatCngKeyFree(
+    _In_opt_ void* KeyData
+    )
+{
+    CXPLAT_CNG_KEY* Key = KeyData;
+    if (Key == NULL) {
+        return;
+    }
+    if (Key->Handle != 0) {
+        NCryptFreeObject(Key->Handle);
+    }
+    if (Key->ProviderHandle != 0) {
+        NCryptFreeObject(Key->ProviderHandle);
+    }
+    BN_free(Key->Modulus);
+    BN_free(Key->Exponent);
+    OPENSSL_clear_free(Key, sizeof(*Key));
+}
+
+static
+int
+CxPlatCngKeyImport(
+    _In_ void* KeyData,
+    _In_ int Selection,
+    _In_reads_(1) const OSSL_PARAM Params[]
+    )
+{
+    CXPLAT_CNG_KEY* Key = KeyData;
+    const OSSL_PARAM* Modulus = OSSL_PARAM_locate_const(Params, OSSL_PKEY_PARAM_RSA_N);
+    const OSSL_PARAM* Exponent = OSSL_PARAM_locate_const(Params, OSSL_PKEY_PARAM_RSA_E);
+    BIGNUM* NewModulus = NULL;
+    BIGNUM* NewExponent = NULL;
+    const char* ProviderName = NULL;
+    const char* KeyName = NULL;
+    WCHAR WideProviderName[CXPLAT_CNG_MAX_NAME] = {0};
+    WCHAR WideKeyName[CXPLAT_CNG_MAX_NAME] = {0};
+    NCRYPT_PROV_HANDLE NewProviderHandle = 0;
+    NCRYPT_KEY_HANDLE NewHandle = 0;
+
+    if (Key == NULL ||
+        (Selection & OSSL_KEYMGMT_SELECT_PUBLIC_KEY) == 0 ||
+        Modulus == NULL || Exponent == NULL ||
+        !OSSL_PARAM_get_BN(Modulus, &NewModulus) ||
+        !OSSL_PARAM_get_BN(Exponent, &NewExponent) ||
+        BN_is_zero(NewModulus) || BN_is_negative(NewModulus) ||
+        BN_is_zero(NewExponent) || BN_is_negative(NewExponent)) {
+        BN_free(NewModulus);
+        BN_free(NewExponent);
+        return 0;
+    }
+
+    if ((Selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) != 0) {
+        const OSSL_PARAM* Provider = OSSL_PARAM_locate_const(Params, CXPLAT_CNG_KSP_PARAM);
+        const OSSL_PARAM* Name = OSSL_PARAM_locate_const(Params, CXPLAT_CNG_KEY_NAME_PARAM);
+        if (Provider == NULL || Name == NULL ||
+            !OSSL_PARAM_get_utf8_string_ptr(Provider, &ProviderName) ||
+            !OSSL_PARAM_get_utf8_string_ptr(Name, &KeyName) ||
+            MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, ProviderName, -1,
+                                WideProviderName, ARRAYSIZE(WideProviderName)) <= 0 ||
+            MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, KeyName, -1,
+                                WideKeyName, ARRAYSIZE(WideKeyName)) <= 0 ||
+            !CxPlatCngOpenNamedKey(WideProviderName, WideKeyName,
+                                   &NewProviderHandle, &NewHandle)) {
+            BN_free(NewModulus);
+            BN_free(NewExponent);
+            return 0;
+        }
+    }
+
+    if (Key->Handle != 0) {
+        NCryptFreeObject(Key->Handle);
+    }
+    if (Key->ProviderHandle != 0) {
+        NCryptFreeObject(Key->ProviderHandle);
+    }
+    BN_free(Key->Modulus);
+    BN_free(Key->Exponent);
+    Key->ProviderHandle = NewProviderHandle;
+    Key->Handle = NewHandle;
+    if (NewHandle != 0) {
+        wcscpy_s(Key->ProviderName, ARRAYSIZE(Key->ProviderName), WideProviderName);
+        wcscpy_s(Key->KeyName, ARRAYSIZE(Key->KeyName), WideKeyName);
+    }
+    Key->Modulus = NewModulus;
+    Key->Exponent = NewExponent;
+    Key->Bits = (uint32_t)BN_num_bits(NewModulus);
+    return 1;
+}
+
+static
+const OSSL_PARAM*
+CxPlatCngKeyImportTypes(
+    _In_ int Selection
+    )
+{
+    static const OSSL_PARAM PublicParams[] = {
+        OSSL_PARAM_BN(OSSL_PKEY_PARAM_RSA_N, NULL, 0),
+        OSSL_PARAM_BN(OSSL_PKEY_PARAM_RSA_E, NULL, 0),
+        OSSL_PARAM_END
+    };
+    static const OSSL_PARAM KeyPairParams[] = {
+        OSSL_PARAM_BN(OSSL_PKEY_PARAM_RSA_N, NULL, 0),
+        OSSL_PARAM_BN(OSSL_PKEY_PARAM_RSA_E, NULL, 0),
+        OSSL_PARAM_utf8_string(CXPLAT_CNG_KSP_PARAM, NULL, 0),
+        OSSL_PARAM_utf8_string(CXPLAT_CNG_KEY_NAME_PARAM, NULL, 0),
+        OSSL_PARAM_END
+    };
+    return (Selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) != 0 ?
+        KeyPairParams : PublicParams;
+}
+
+static
+int
+CxPlatCngKeyExport(
+    _In_ void* KeyData,
+    _In_ int Selection,
+    _In_ OSSL_CALLBACK* Callback,
+    _In_opt_ void* CallbackArgument
+    )
+{
+    const CXPLAT_CNG_KEY* Key = KeyData;
+    OSSL_PARAM_BLD* Builder = NULL;
+    OSSL_PARAM* Params = NULL;
+    int Result = 0;
+
+    if (Key == NULL || Callback == NULL || Key->Modulus == NULL || Key->Exponent == NULL ||
+        (Selection & OSSL_KEYMGMT_SELECT_PUBLIC_KEY) == 0 ||
+        (Selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) != 0) {
+        return 0;
+    }
+    Builder = OSSL_PARAM_BLD_new();
+    if (Builder == NULL ||
+        !OSSL_PARAM_BLD_push_BN(Builder, OSSL_PKEY_PARAM_RSA_N, Key->Modulus) ||
+        !OSSL_PARAM_BLD_push_BN(Builder, OSSL_PKEY_PARAM_RSA_E, Key->Exponent) ||
+        (Params = OSSL_PARAM_BLD_to_param(Builder)) == NULL) {
+        goto Exit;
+    }
+    Result = Callback(Params, CallbackArgument);
+Exit:
+    OSSL_PARAM_free(Params);
+    OSSL_PARAM_BLD_free(Builder);
+    return Result;
+}
+
+static
+const OSSL_PARAM*
+CxPlatCngKeyExportTypes(
+    _In_ int Selection
+    )
+{
+    static const OSSL_PARAM PublicParams[] = {
+        OSSL_PARAM_BN(OSSL_PKEY_PARAM_RSA_N, NULL, 0),
+        OSSL_PARAM_BN(OSSL_PKEY_PARAM_RSA_E, NULL, 0),
+        OSSL_PARAM_END
+    };
+    return (Selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) == 0 ? PublicParams : NULL;
+}
+
+static
+int
+CxPlatCngKeyHas(
+    _In_ const void* KeyData,
+    _In_ int Selection
+    )
+{
+    const CXPLAT_CNG_KEY* Key = KeyData;
+    if (Key == NULL) {
+        return 0;
+    }
+    if ((Selection & OSSL_KEYMGMT_SELECT_PUBLIC_KEY) != 0 &&
+        (Key->Modulus == NULL || Key->Exponent == NULL)) {
+        return 0;
+    }
+    if ((Selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) != 0 && Key->Handle == 0) {
+        return 0;
+    }
+    return 1;
+}
+
+static
+int
+CxPlatCngKeyMatch(
+    _In_ const void* FirstKeyData,
+    _In_ const void* SecondKeyData,
+    _In_ int Selection
+    )
+{
+    const CXPLAT_CNG_KEY* First = FirstKeyData;
+    const CXPLAT_CNG_KEY* Second = SecondKeyData;
+    UNREFERENCED_PARAMETER(Selection);
+    return First != NULL && Second != NULL &&
+        First->Modulus != NULL && Second->Modulus != NULL &&
+        First->Exponent != NULL && Second->Exponent != NULL &&
+        BN_cmp(First->Modulus, Second->Modulus) == 0 &&
+        BN_cmp(First->Exponent, Second->Exponent) == 0;
+}
+
+static
+int
+CxPlatCngKeyValidate(
+    _In_ const void* KeyData,
+    _In_ int Selection,
+    _In_ int CheckType
+    )
+{
+    UNREFERENCED_PARAMETER(CheckType);
+    return CxPlatCngKeyHas(KeyData, Selection);
+}
+
+static
+uint32_t
+CxPlatCngSecurityBits(
+    _In_ uint32_t Bits
+    )
+{
+    if (Bits >= 15360) return 256;
+    if (Bits >= 7680) return 192;
+    if (Bits >= 3072) return 128;
+    if (Bits >= 2048) return 112;
+    return 0;
+}
+
+static
+int
+CxPlatCngKeyGetParams(
+    _In_ void* KeyData,
+    _Inout_updates_(1) OSSL_PARAM Params[]
+    )
+{
+    const CXPLAT_CNG_KEY* Key = KeyData;
+    OSSL_PARAM* Param;
+    int Result = 1;
+    if (Key == NULL || Key->Bits == 0) {
+        return 0;
+    }
+    Param = OSSL_PARAM_locate(Params, OSSL_PKEY_PARAM_BITS);
+    if (Param != NULL) Result &= OSSL_PARAM_set_int(Param, (int)Key->Bits);
+    Param = OSSL_PARAM_locate(Params, OSSL_PKEY_PARAM_SECURITY_BITS);
+    if (Param != NULL) Result &= OSSL_PARAM_set_int(Param, (int)CxPlatCngSecurityBits(Key->Bits));
+    Param = OSSL_PARAM_locate(Params, OSSL_PKEY_PARAM_MAX_SIZE);
+    if (Param != NULL) Result &= OSSL_PARAM_set_int(Param, (int)((Key->Bits + 7) / 8));
+    Param = OSSL_PARAM_locate(Params, OSSL_PKEY_PARAM_DEFAULT_DIGEST);
+    if (Param != NULL) Result &= OSSL_PARAM_set_utf8_string(Param, "SHA256");
+    return Result;
+}
+
+static
+const OSSL_PARAM*
+CxPlatCngKeyGettableParams(
+    _In_opt_ void* ProviderContext
+    )
+{
+    static const OSSL_PARAM Params[] = {
+        OSSL_PARAM_int(OSSL_PKEY_PARAM_BITS, NULL),
+        OSSL_PARAM_int(OSSL_PKEY_PARAM_SECURITY_BITS, NULL),
+        OSSL_PARAM_int(OSSL_PKEY_PARAM_MAX_SIZE, NULL),
+        OSSL_PARAM_utf8_string(OSSL_PKEY_PARAM_DEFAULT_DIGEST, NULL, 0),
+        OSSL_PARAM_END
+    };
+    UNREFERENCED_PARAMETER(ProviderContext);
+    return Params;
+}
+
+static
+void*
+CxPlatCngKeyDuplicate(
+    _In_ const void* KeyData,
+    _In_ int Selection
+    )
+{
+    const CXPLAT_CNG_KEY* Source = KeyData;
+    CXPLAT_CNG_KEY* Result = NULL;
+    if (Source == NULL || !CxPlatCngKeyHas(Source, Selection)) {
+        return NULL;
+    }
+    Result = OPENSSL_zalloc(sizeof(*Result));
+    if (Result == NULL ||
+        (Source->Modulus != NULL && (Result->Modulus = BN_dup(Source->Modulus)) == NULL) ||
+        (Source->Exponent != NULL && (Result->Exponent = BN_dup(Source->Exponent)) == NULL) ||
+        (Source->Handle != 0 &&
+         !CxPlatCngOpenNamedKey(Source->ProviderName, Source->KeyName,
+                                &Result->ProviderHandle, &Result->Handle))) {
+        CxPlatCngKeyFree(Result);
+        return NULL;
+    }
+    Result->Bits = Source->Bits;
+    if (Source->Handle != 0) {
+        wcscpy_s(Result->ProviderName, ARRAYSIZE(Result->ProviderName), Source->ProviderName);
+        wcscpy_s(Result->KeyName, ARRAYSIZE(Result->KeyName), Source->KeyName);
+    }
+    return Result;
+}
+
+static
+const char*
+CxPlatCngKeyQueryOperationName(
+    _In_ int OperationId
+    )
+{
+    return OperationId == OSSL_OP_SIGNATURE ? "RSA" : NULL;
+}
+
+static const OSSL_DISPATCH CxPlatCngKeyFunctions[] = {
+    { OSSL_FUNC_KEYMGMT_NEW, (void(*)(void))CxPlatCngKeyNew },
+    { OSSL_FUNC_KEYMGMT_FREE, (void(*)(void))CxPlatCngKeyFree },
+    { OSSL_FUNC_KEYMGMT_GET_PARAMS, (void(*)(void))CxPlatCngKeyGetParams },
+    { OSSL_FUNC_KEYMGMT_GETTABLE_PARAMS, (void(*)(void))CxPlatCngKeyGettableParams },
+    { OSSL_FUNC_KEYMGMT_HAS, (void(*)(void))CxPlatCngKeyHas },
+    { OSSL_FUNC_KEYMGMT_MATCH, (void(*)(void))CxPlatCngKeyMatch },
+    { OSSL_FUNC_KEYMGMT_VALIDATE, (void(*)(void))CxPlatCngKeyValidate },
+    { OSSL_FUNC_KEYMGMT_IMPORT, (void(*)(void))CxPlatCngKeyImport },
+    { OSSL_FUNC_KEYMGMT_IMPORT_TYPES, (void(*)(void))CxPlatCngKeyImportTypes },
+    { OSSL_FUNC_KEYMGMT_EXPORT, (void(*)(void))CxPlatCngKeyExport },
+    { OSSL_FUNC_KEYMGMT_EXPORT_TYPES, (void(*)(void))CxPlatCngKeyExportTypes },
+    { OSSL_FUNC_KEYMGMT_DUP, (void(*)(void))CxPlatCngKeyDuplicate },
+    { OSSL_FUNC_KEYMGMT_QUERY_OPERATION_NAME, (void(*)(void))CxPlatCngKeyQueryOperationName },
+    OSSL_DISPATCH_END
+};
+
+static
+BOOLEAN
+CxPlatCngSetDigest(
+    _Inout_ CXPLAT_CNG_SIGNATURE_CONTEXT* Context,
+    _In_z_ const char* Digest
+    )
+{
+    if (_stricmp(Digest, "SHA256") == 0 || _stricmp(Digest, "SHA2-256") == 0) {
+        Context->HashAlgorithm = BCRYPT_SHA256_ALGORITHM;
+        Context->HashLength = 32;
+    } else if (_stricmp(Digest, "SHA384") == 0 || _stricmp(Digest, "SHA2-384") == 0) {
+        Context->HashAlgorithm = BCRYPT_SHA384_ALGORITHM;
+        Context->HashLength = 48;
+    } else if (_stricmp(Digest, "SHA512") == 0 || _stricmp(Digest, "SHA2-512") == 0) {
+        Context->HashAlgorithm = BCRYPT_SHA512_ALGORITHM;
+        Context->HashLength = 64;
+    } else {
+        return FALSE;
+    }
+    Context->SaltLength = Context->HashLength;
+    return TRUE;
+}
+
+static
+int
+CxPlatCngSignatureSetParams(
+    _In_ void* SignatureContext,
+    _In_reads_opt_(1) const OSSL_PARAM Params[]
+    )
+{
+    CXPLAT_CNG_SIGNATURE_CONTEXT* Context = SignatureContext;
+    const OSSL_PARAM* Param;
+    const char* Text;
+    int Number;
+    if (Context == NULL || Params == NULL) {
+        return Context != NULL;
+    }
+
+    Param = OSSL_PARAM_locate_const(Params, OSSL_SIGNATURE_PARAM_DIGEST);
+    if (Param != NULL) {
+        if (!OSSL_PARAM_get_utf8_string_ptr(Param, &Text) || !CxPlatCngSetDigest(Context, Text)) {
+            return 0;
+        }
+    }
+    Param = OSSL_PARAM_locate_const(Params, OSSL_SIGNATURE_PARAM_PAD_MODE);
+    if (Param != NULL) {
+        if (Param->data_type == OSSL_PARAM_UTF8_STRING) {
+            if (!OSSL_PARAM_get_utf8_string_ptr(Param, &Text) ||
+                _stricmp(Text, OSSL_PKEY_RSA_PAD_MODE_PSS) != 0) {
+                return 0;
+            }
+        } else if (!OSSL_PARAM_get_int(Param, &Number) || Number != RSA_PKCS1_PSS_PADDING) {
+            return 0;
+        }
+        Context->PssPadding = TRUE;
+    }
+    Param = OSSL_PARAM_locate_const(Params, OSSL_SIGNATURE_PARAM_MGF1_DIGEST);
+    if (Param != NULL) {
+        LPCWSTR PreviousAlgorithm = Context->HashAlgorithm;
+        uint32_t PreviousLength = Context->HashLength;
+        if (!OSSL_PARAM_get_utf8_string_ptr(Param, &Text) ||
+            !CxPlatCngSetDigest(Context, Text) || Context->HashAlgorithm != PreviousAlgorithm) {
+            Context->HashAlgorithm = PreviousAlgorithm;
+            Context->HashLength = PreviousLength;
+            Context->SaltLength = PreviousLength;
+            return 0;
+        }
+    }
+    Param = OSSL_PARAM_locate_const(Params, OSSL_SIGNATURE_PARAM_PSS_SALTLEN);
+    if (Param != NULL) {
+        if (Param->data_type == OSSL_PARAM_UTF8_STRING) {
+            if (!OSSL_PARAM_get_utf8_string_ptr(Param, &Text) || _stricmp(Text, "digest") != 0) {
+                return 0;
+            }
+            Context->SaltLength = Context->HashLength;
+        } else if (!OSSL_PARAM_get_int(Param, &Number) || Number < 0 ||
+                   (uint32_t)Number != Context->HashLength) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static
+void*
+CxPlatCngSignatureNew(
+    _In_opt_ void* ProviderContext,
+    _In_opt_z_ const char* PropertyQuery
+    )
+{
+    UNREFERENCED_PARAMETER(ProviderContext);
+    UNREFERENCED_PARAMETER(PropertyQuery);
+    return OPENSSL_zalloc(sizeof(CXPLAT_CNG_SIGNATURE_CONTEXT));
+}
+
+static
+void
+CxPlatCngSignatureFree(
+    _In_opt_ void* SignatureContext
+    )
+{
+    OPENSSL_clear_free(SignatureContext, sizeof(CXPLAT_CNG_SIGNATURE_CONTEXT));
+}
+
+static
+void*
+CxPlatCngSignatureDuplicate(
+    _In_ void* SignatureContext
+    )
+{
+    CXPLAT_CNG_SIGNATURE_CONTEXT* Result = OPENSSL_malloc(sizeof(*Result));
+    if (Result != NULL) {
+        *Result = *(CXPLAT_CNG_SIGNATURE_CONTEXT*)SignatureContext;
+    }
+    return Result;
+}
+
+static
+int
+CxPlatCngDigestSignInitialize(
+    _In_ void* SignatureContext,
+    _In_z_ const char* Digest,
+    _In_ void* KeyData,
+    _In_reads_opt_(1) const OSSL_PARAM Params[]
+    )
+{
+    CXPLAT_CNG_SIGNATURE_CONTEXT* Context = SignatureContext;
+    CXPLAT_CNG_KEY* Key = KeyData;
+    if (Context == NULL || Key == NULL || Key->Handle == 0 ||
+        !CxPlatCngSetDigest(Context, Digest)) {
+        return 0;
+    }
+    Context->Key = Key;
+    Context->PssPadding = FALSE;
+    return CxPlatCngSignatureSetParams(Context, Params);
+}
+
+static
+int
+CxPlatCngDigestSign(
+    _In_ void* SignatureContext,
+    _Out_writes_bytes_to_opt_(SignatureSize, *SignatureLength) unsigned char* Signature,
+    _Out_ size_t* SignatureLength,
+    _In_ size_t SignatureSize,
+    _In_reads_bytes_(MessageLength) const unsigned char* Message,
+    _In_ size_t MessageLength
+    )
+{
+    CXPLAT_CNG_SIGNATURE_CONTEXT* Context = SignatureContext;
+    BCRYPT_ALG_HANDLE Algorithm = NULL;
+    BCRYPT_HASH_HANDLE Hash = NULL;
+    PUCHAR HashObject = NULL;
+    DWORD HashObjectLength = 0;
+    DWORD ResultLength = 0;
+    PUCHAR Digest = NULL;
+    DWORD RequiredSignatureLength = 0;
+    SECURITY_STATUS Status;
+    BCRYPT_PSS_PADDING_INFO Padding;
+    int Result = 0;
+
+    if (Context == NULL || Context->Key == NULL || Context->Key->Handle == 0 ||
+        !Context->PssPadding || SignatureLength == NULL ||
+        Message == NULL || MessageLength > MAXDWORD) {
+        return 0;
+    }
+    RequiredSignatureLength = (Context->Key->Bits + 7) / 8;
+    *SignatureLength = RequiredSignatureLength;
+    if (Signature == NULL) {
+        return 1;
+    }
+    if (SignatureSize < RequiredSignatureLength ||
+        BCryptOpenAlgorithmProvider(&Algorithm, Context->HashAlgorithm, NULL, 0) != ERROR_SUCCESS ||
+        BCryptGetProperty(Algorithm, BCRYPT_OBJECT_LENGTH, (PUCHAR)&HashObjectLength,
+                          sizeof(HashObjectLength), &ResultLength, 0) != ERROR_SUCCESS ||
+        HashObjectLength == 0) {
+        goto Exit;
+    }
+    HashObject = OPENSSL_malloc(HashObjectLength);
+    Digest = OPENSSL_malloc(Context->HashLength);
+    if (HashObject == NULL || Digest == NULL ||
+        BCryptCreateHash(Algorithm, &Hash, HashObject, HashObjectLength, NULL, 0, 0) != ERROR_SUCCESS ||
+        BCryptHashData(Hash, (PUCHAR)Message, (ULONG)MessageLength, 0) != ERROR_SUCCESS ||
+        BCryptFinishHash(Hash, Digest, Context->HashLength, 0) != ERROR_SUCCESS) {
+        goto Exit;
+    }
+
+    Padding.pszAlgId = Context->HashAlgorithm;
+    Padding.cbSalt = Context->SaltLength;
+    Status = NCryptSignHash(
+        Context->Key->Handle,
+        &Padding,
+        Digest,
+        Context->HashLength,
+        Signature,
+        (DWORD)SignatureSize,
+        &ResultLength,
+        BCRYPT_PAD_PSS);
+    if (Status != ERROR_SUCCESS || ResultLength != RequiredSignatureLength) {
+        goto Exit;
+    }
+    *SignatureLength = ResultLength;
+    Result = 1;
+Exit:
+    if (Hash != NULL) BCryptDestroyHash(Hash);
+    if (Algorithm != NULL) BCryptCloseAlgorithmProvider(Algorithm, 0);
+    OPENSSL_clear_free(Digest, Context != NULL ? Context->HashLength : 0);
+    OPENSSL_clear_free(HashObject, HashObjectLength);
+    return Result;
+}
+
+static
+const OSSL_PARAM*
+CxPlatCngSignatureSettableParams(
+    _In_opt_ void* SignatureContext,
+    _In_opt_ void* ProviderContext
+    )
+{
+    static const OSSL_PARAM Params[] = {
+        OSSL_PARAM_utf8_string(OSSL_SIGNATURE_PARAM_DIGEST, NULL, 0),
+        OSSL_PARAM_utf8_string(OSSL_SIGNATURE_PARAM_PAD_MODE, NULL, 0),
+        OSSL_PARAM_utf8_string(OSSL_SIGNATURE_PARAM_MGF1_DIGEST, NULL, 0),
+        OSSL_PARAM_utf8_string(OSSL_SIGNATURE_PARAM_PSS_SALTLEN, NULL, 0),
+        OSSL_PARAM_END
+    };
+    UNREFERENCED_PARAMETER(SignatureContext);
+    UNREFERENCED_PARAMETER(ProviderContext);
+    return Params;
+}
+
+static const OSSL_DISPATCH CxPlatCngSignatureFunctions[] = {
+    { OSSL_FUNC_SIGNATURE_NEWCTX, (void(*)(void))CxPlatCngSignatureNew },
+    { OSSL_FUNC_SIGNATURE_FREECTX, (void(*)(void))CxPlatCngSignatureFree },
+    { OSSL_FUNC_SIGNATURE_DUPCTX, (void(*)(void))CxPlatCngSignatureDuplicate },
+    { OSSL_FUNC_SIGNATURE_DIGEST_SIGN_INIT, (void(*)(void))CxPlatCngDigestSignInitialize },
+    { OSSL_FUNC_SIGNATURE_DIGEST_SIGN, (void(*)(void))CxPlatCngDigestSign },
+    { OSSL_FUNC_SIGNATURE_SET_CTX_PARAMS, (void(*)(void))CxPlatCngSignatureSetParams },
+    { OSSL_FUNC_SIGNATURE_SETTABLE_CTX_PARAMS, (void(*)(void))CxPlatCngSignatureSettableParams },
+    OSSL_DISPATCH_END
+};
+
+static const OSSL_ALGORITHM CxPlatCngKeyAlgorithms[] = {
+    { "RSA:rsaEncryption", "provider=" CXPLAT_CNG_PROVIDER_NAME, CxPlatCngKeyFunctions,
+      "DeskLink opaque CNG RSA key" },
+    { NULL, NULL, NULL, NULL }
+};
+
+static const OSSL_ALGORITHM CxPlatCngSignatureAlgorithms[] = {
+    { "RSA:rsaEncryption", "provider=" CXPLAT_CNG_PROVIDER_NAME, CxPlatCngSignatureFunctions,
+      "DeskLink CNG RSA-PSS signature" },
+    { NULL, NULL, NULL, NULL }
+};
+
+static
+const OSSL_ALGORITHM*
+CxPlatCngProviderQuery(
+    _In_opt_ void* ProviderContext,
+    _In_ int OperationId,
+    _Out_ int* NoCache
+    )
+{
+    UNREFERENCED_PARAMETER(ProviderContext);
+    *NoCache = 0;
+    if (OperationId == OSSL_OP_KEYMGMT) return CxPlatCngKeyAlgorithms;
+    if (OperationId == OSSL_OP_SIGNATURE) return CxPlatCngSignatureAlgorithms;
+    return NULL;
+}
+
+static const OSSL_DISPATCH CxPlatCngProviderFunctions[] = {
+    { OSSL_FUNC_PROVIDER_QUERY_OPERATION, (void(*)(void))CxPlatCngProviderQuery },
+    OSSL_DISPATCH_END
+};
+
+static
+OSSL_provider_init_fn CxPlatCngProviderInit;
+
+static
+int
+CxPlatCngProviderInit(
+    _In_ const OSSL_CORE_HANDLE* Handle,
+    _In_reads_(1) const OSSL_DISPATCH Dispatch[],
+    _Outptr_result_maybenull_ const OSSL_DISPATCH** ProviderDispatch,
+    _Outptr_result_maybenull_ void** ProviderContext
+    )
+{
+    UNREFERENCED_PARAMETER(Handle);
+    UNREFERENCED_PARAMETER(Dispatch);
+    *ProviderContext = NULL;
+    *ProviderDispatch = CxPlatCngProviderFunctions;
+    return 1;
+}
+
+static
+BOOLEAN
+CxPlatCngReadDwordProperty(
+    _In_ NCRYPT_KEY_HANDLE Key,
+    _In_z_ LPCWSTR Property,
+    _Out_ DWORD* Value
+    )
+{
+    DWORD ResultLength = 0;
+    return NCryptGetProperty(Key, Property, (PBYTE)Value, sizeof(*Value), &ResultLength, 0) == ERROR_SUCCESS &&
+        ResultLength == sizeof(*Value);
+}
+
+QUIC_STATUS
+CxPlatCngProviderInitialize(
+    _In_ OSSL_LIB_CTX* LibCtx,
+    _Outptr_ OSSL_PROVIDER** Provider
+    )
+{
+    *Provider = NULL;
+    if (LibCtx == NULL ||
+        !OSSL_PROVIDER_add_builtin(LibCtx, CXPLAT_CNG_PROVIDER_NAME, CxPlatCngProviderInit) ||
+        (*Provider = OSSL_PROVIDER_load(LibCtx, CXPLAT_CNG_PROVIDER_NAME)) == NULL) {
+        return QUIC_STATUS_TLS_ERROR;
+    }
+    return QUIC_STATUS_SUCCESS;
+}
+
+QUIC_STATUS
+CxPlatCngProviderLoadCredential(
+    _In_ OSSL_LIB_CTX* LibCtx,
+    _In_ SSL_CTX* SSLCtx,
+    _In_ QUIC_CERTIFICATE* CertificateContext,
+    _Outptr_ EVP_PKEY** PrivateKey,
+    _Outptr_ X509** Certificate
+    )
+{
+    PCCERT_CONTEXT WindowsCertificate = (PCCERT_CONTEXT)CertificateContext;
+    NCRYPT_KEY_HANDLE Key = 0;
+    DWORD KeySpec = 0;
+    BOOL CallerMustFree = FALSE;
+    DWORD ExportPolicy = 0;
+    DWORD KeyUsage = 0;
+    WCHAR Algorithm[64] = {0};
+    DWORD AlgorithmLength = 0;
+    NCRYPT_PROV_HANDLE AcquiredProvider = 0;
+    WCHAR ProviderName[CXPLAT_CNG_MAX_NAME] = {0};
+    WCHAR KeyName[CXPLAT_CNG_MAX_NAME] = {0};
+    char Utf8ProviderName[CXPLAT_CNG_MAX_NAME * 3] = {0};
+    char Utf8KeyName[CXPLAT_CNG_MAX_NAME * 3] = {0};
+    DWORD ProviderHandleLength = 0;
+    DWORD ProviderNameLength = 0;
+    DWORD KeyNameLength = 0;
+    X509* X509Certificate = NULL;
+    EVP_PKEY* PublicKey = NULL;
+    EVP_PKEY* OpaqueKey = NULL;
+    EVP_PKEY_CTX* KeyContext = NULL;
+    OSSL_PARAM_BLD* Builder = NULL;
+    OSSL_PARAM* Params = NULL;
+    BIGNUM* Modulus = NULL;
+    BIGNUM* Exponent = NULL;
+    EVP_MD_CTX* SignContext = NULL;
+    EVP_MD_CTX* VerifyContext = NULL;
+    EVP_PKEY_CTX* PaddingContext = NULL;
+    unsigned char Challenge[32];
+    unsigned char* Signature = NULL;
+    size_t SignatureLength = 0;
+    const unsigned char* EncodedCertificate;
+    QUIC_STATUS Status = QUIC_STATUS_TLS_ERROR;
+
+    *PrivateKey = NULL;
+    *Certificate = NULL;
+    if (LibCtx == NULL || SSLCtx == NULL || WindowsCertificate == NULL ||
+        WindowsCertificate->pbCertEncoded == NULL || WindowsCertificate->cbCertEncoded == 0 ||
+        !CryptAcquireCertificatePrivateKey(
+            WindowsCertificate,
+            CRYPT_ACQUIRE_ONLY_NCRYPT_KEY_FLAG | CRYPT_ACQUIRE_SILENT_FLAG,
+            NULL,
+            (HCRYPTPROV_OR_NCRYPT_KEY_HANDLE*)&Key,
+            &KeySpec,
+            &CallerMustFree) ||
+        KeySpec != CERT_NCRYPT_KEY_SPEC || Key == 0 ||
+        !CxPlatCngReadDwordProperty(Key, NCRYPT_EXPORT_POLICY_PROPERTY, &ExportPolicy) || ExportPolicy != 0 ||
+        !CxPlatCngReadDwordProperty(Key, NCRYPT_KEY_USAGE_PROPERTY, &KeyUsage) ||
+        (KeyUsage & NCRYPT_ALLOW_SIGNING_FLAG) == 0 ||
+        NCryptGetProperty(Key, NCRYPT_ALGORITHM_PROPERTY, (PBYTE)Algorithm, sizeof(Algorithm),
+                          &AlgorithmLength, 0) != ERROR_SUCCESS ||
+        AlgorithmLength < sizeof(WCHAR) || _wcsicmp(Algorithm, NCRYPT_RSA_ALGORITHM) != 0 ||
+        NCryptGetProperty(Key, NCRYPT_PROVIDER_HANDLE_PROPERTY, (PBYTE)&AcquiredProvider,
+                          sizeof(AcquiredProvider), &ProviderHandleLength, 0) != ERROR_SUCCESS ||
+        ProviderHandleLength != sizeof(AcquiredProvider) || AcquiredProvider == 0 ||
+        NCryptGetProperty(AcquiredProvider, NCRYPT_NAME_PROPERTY, (PBYTE)ProviderName,
+                          sizeof(ProviderName), &ProviderNameLength, 0) != ERROR_SUCCESS ||
+        ProviderNameLength < sizeof(WCHAR) || ProviderNameLength > sizeof(ProviderName) ||
+        ProviderName[(ProviderNameLength / sizeof(WCHAR)) - 1] != L'\0' ||
+        NCryptGetProperty(Key, NCRYPT_NAME_PROPERTY, (PBYTE)KeyName,
+                          sizeof(KeyName), &KeyNameLength, 0) != ERROR_SUCCESS ||
+        KeyNameLength < sizeof(WCHAR) || KeyNameLength > sizeof(KeyName) ||
+        KeyName[(KeyNameLength / sizeof(WCHAR)) - 1] != L'\0' ||
+        WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, ProviderName, -1,
+                            Utf8ProviderName, sizeof(Utf8ProviderName), NULL, NULL) <= 0 ||
+        WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, KeyName, -1,
+                            Utf8KeyName, sizeof(Utf8KeyName), NULL, NULL) <= 0) {
+        goto Exit;
+    }
+
+    X509Certificate = X509_new_ex(LibCtx, "provider=default");
+    EncodedCertificate = WindowsCertificate->pbCertEncoded;
+    if (X509Certificate == NULL ||
+        d2i_X509(&X509Certificate, &EncodedCertificate, WindowsCertificate->cbCertEncoded) == NULL ||
+        EncodedCertificate != WindowsCertificate->pbCertEncoded + WindowsCertificate->cbCertEncoded ||
+        (PublicKey = X509_get_pubkey(X509Certificate)) == NULL ||
+        !EVP_PKEY_is_a(PublicKey, "RSA") ||
+        !EVP_PKEY_get_bn_param(PublicKey, OSSL_PKEY_PARAM_RSA_N, &Modulus) ||
+        !EVP_PKEY_get_bn_param(PublicKey, OSSL_PKEY_PARAM_RSA_E, &Exponent)) {
+        goto Exit;
+    }
+
+    Builder = OSSL_PARAM_BLD_new();
+    if (Builder == NULL ||
+        !OSSL_PARAM_BLD_push_BN(Builder, OSSL_PKEY_PARAM_RSA_N, Modulus) ||
+        !OSSL_PARAM_BLD_push_BN(Builder, OSSL_PKEY_PARAM_RSA_E, Exponent) ||
+        !OSSL_PARAM_BLD_push_utf8_string(Builder, CXPLAT_CNG_KSP_PARAM,
+                                         Utf8ProviderName, 0) ||
+        !OSSL_PARAM_BLD_push_utf8_string(Builder, CXPLAT_CNG_KEY_NAME_PARAM,
+                                         Utf8KeyName, 0) ||
+        (Params = OSSL_PARAM_BLD_to_param(Builder)) == NULL ||
+        (KeyContext = EVP_PKEY_CTX_new_from_name(
+            LibCtx, "RSA", "provider=" CXPLAT_CNG_PROVIDER_NAME)) == NULL ||
+        EVP_PKEY_fromdata_init(KeyContext) <= 0 ||
+        EVP_PKEY_fromdata(KeyContext, &OpaqueKey, EVP_PKEY_KEYPAIR, Params) <= 0) {
+        goto Exit;
+    }
+
+    if (BCryptGenRandom(NULL, Challenge, sizeof(Challenge), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != ERROR_SUCCESS ||
+        (SignContext = EVP_MD_CTX_new()) == NULL ||
+        EVP_DigestSignInit_ex(SignContext, &PaddingContext, "SHA256", LibCtx,
+                              "provider=" CXPLAT_CNG_PROVIDER_NAME, OpaqueKey, NULL) <= 0 ||
+        EVP_PKEY_CTX_set_rsa_padding(PaddingContext, RSA_PKCS1_PSS_PADDING) <= 0 ||
+        EVP_PKEY_CTX_set_rsa_pss_saltlen(PaddingContext, RSA_PSS_SALTLEN_DIGEST) <= 0 ||
+        EVP_DigestSign(SignContext, NULL, &SignatureLength, Challenge, sizeof(Challenge)) <= 0 ||
+        (Signature = OPENSSL_malloc(SignatureLength)) == NULL ||
+        EVP_DigestSign(SignContext, Signature, &SignatureLength, Challenge, sizeof(Challenge)) <= 0) {
+        goto Exit;
+    }
+
+    PaddingContext = NULL;
+    if ((VerifyContext = EVP_MD_CTX_new()) == NULL ||
+        EVP_DigestVerifyInit_ex(VerifyContext, &PaddingContext, "SHA256", LibCtx,
+                                "provider=default", PublicKey, NULL) <= 0 ||
+        EVP_PKEY_CTX_set_rsa_padding(PaddingContext, RSA_PKCS1_PSS_PADDING) <= 0 ||
+        EVP_PKEY_CTX_set_rsa_pss_saltlen(PaddingContext, RSA_PSS_SALTLEN_DIGEST) <= 0 ||
+        EVP_DigestVerify(VerifyContext, Signature, SignatureLength,
+                         Challenge, sizeof(Challenge)) != 1 ||
+        SSL_CTX_use_cert_and_key(SSLCtx, X509Certificate, OpaqueKey, NULL, 1) != 1 ||
+        SSL_CTX_check_private_key(SSLCtx) != 1) {
+        goto Exit;
+    }
+
+    *PrivateKey = OpaqueKey;
+    OpaqueKey = NULL;
+    *Certificate = X509Certificate;
+    X509Certificate = NULL;
+    Status = QUIC_STATUS_SUCCESS;
+Exit:
+    OPENSSL_cleanse(Challenge, sizeof(Challenge));
+    OPENSSL_free(Signature);
+    EVP_MD_CTX_free(VerifyContext);
+    EVP_MD_CTX_free(SignContext);
+    OSSL_PARAM_free(Params);
+    OSSL_PARAM_BLD_free(Builder);
+    EVP_PKEY_CTX_free(KeyContext);
+    BN_free(Modulus);
+    BN_free(Exponent);
+    EVP_PKEY_free(PublicKey);
+    EVP_PKEY_free(OpaqueKey);
+    X509_free(X509Certificate);
+    if (CallerMustFree && Key != 0) {
+        NCryptFreeObject(Key);
+    }
+    return Status;
+}
+
+#endif
